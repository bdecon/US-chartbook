# US Chartbook Environment Configuration
# Copy this file to .env and fill in your values

# API Keys
BEA_API_KEY=your_bea_api_key_here
BLS_API_KEY=your_bls_api_key_here
CENSUS_API_KEY=your_census_api_key_here
FRED_API_KEY=your_fred_api_key_here
EIA_API_KEY=your_eia_api_key_here

# Paths (optional - defaults to project-relative paths if not set)
X13_PATH=/path/to/x13as/
CHARTBOOK_DIR=/path/to/uschartbook/notebooks/
DB_PATH=/path/to/uschartbook/data/chartbook.db
CPS_DATA_DIR=/path/to/CPS/data/clean/
ACS_DATA_DIR=/path/to/ACS/
